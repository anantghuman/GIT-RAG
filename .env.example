APP_NAME=git-rag
ENVIRONMENT=local
PROJECT_DIR=/app
CLONE_REPO_DIR=/data/repos
LOCAL_OBJECT_DIR=/data/objects

DATABASE_URL=postgresql://gitrag:gitrag@postgres:5432/gitrag
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INGESTION_TOPIC=gitrag.ingestion
KAFKA_CONSUMER_GROUP=gitrag-workers

AWS_REGION=us-east-1
S3_BUCKET=gitrag-local
S3_ENDPOINT_URL=http://localstack:4566

PINECONE_API_KEY=
PINECONE_INDEX_NAME=git-rag-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
GITRAG_VECTOR_BACKEND=pinecone

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
GITRAG_DETERMINISTIC_EMBEDDINGS=false

GITHUB_WEBHOOK_SECRET=
GITHUB_ACCESS_TOKEN=

SNAPSHOT_INTERVAL=10
SNAPSHOT_CHANGE_THRESHOLD=0.30
EMBEDDING_BATCH_SIZE=64
VECTOR_UPSERT_BATCH_SIZE=100
QUERY_CACHE_TTL_SECONDS=300
DEFAULT_TOP_K=8
INDEX_VENDOR_CODE=false
